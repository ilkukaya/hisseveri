---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdPlaceholder from '../components/astro/AdPlaceholder.astro';
import StockListView from '../components/react/StockListView.tsx';
import stocksData from '../../data/stocks.json';
import sectorsData from '../../data/sectors.json';

const stocks = stocksData.stocks.map((s) => ({
  ticker: s.ticker,
  name: s.name,
  sector: s.sector,
  indexes: s.indexes,
  price: s.price,
  changePercent: s.changePercent,
  volume: s.volume,
  marketCap: s.marketCap,
  pe: s.pe,
  pb: s.pb,
}));

const sectors = [...new Set(stocksData.stocks.map((s) => s.sector))].sort();
---

<BaseLayout
  title="Tüm BIST Hisseleri"
  description="Borsa İstanbul'daki tüm hisselerin fiyatları, değişim oranları, F/K, PD/DD rasyoları. Sektör ve endeks bazlı filtreleme."
>
  <div class="mx-auto max-w-7xl px-4 py-8">
    <h1 class="mb-2 text-2xl font-bold text-gray-900 dark:text-white">BIST Hisseleri</h1>
    <p class="mb-6 text-gray-500 dark:text-gray-400">
      Borsa İstanbul'daki tüm hisseleri filtreleyin ve karşılaştırın.
    </p>

    <AdPlaceholder slot="hisseler-top" format="leaderboard" />

    <StockListView client:load stocks={stocks} sectors={sectors} />

    <AdPlaceholder slot="hisseler-bottom" format="leaderboard" />
  </div>
</BaseLayout>
